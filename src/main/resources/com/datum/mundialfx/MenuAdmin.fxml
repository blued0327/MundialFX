<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1000.0" stylesheets="@../../../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <left>
      <VBox fillWidth="true" prefHeight="600.0" prefWidth="220.0" spacing="8.0" style="-fx-background-color: #08164B; -fx-padding: 20;" BorderPane.alignment="TOP_CENTER">
         <children>
            <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../Images/logo.png" />
               </image>
            </ImageView>
            <Label text="Mundial 2026" textFill="#ebe7e7">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="20.0" top="10.0" />
               </padding>
            </Label>
            <Button fx:id="btnVentas" alignment="CENTER" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irVentas" styleClass="menu-boton" text="Ventas" textFill="#f5f5f5">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="btnCliente" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irCliente" styleClass="menu-boton" text="Clientes" textFill="#f5f5f5">
