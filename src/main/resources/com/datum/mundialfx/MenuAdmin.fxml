               </font>
            </Button>
            <Button fx:id="btnPartido" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irPartido" styleClass="menu-boton" text="Partidos" textFill="#f5f5f5">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="btnTicket" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irTicket" styleClass="menu-boton" text="Tickets" textFill="#f5f5f5">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="btnReporte" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irReporte" styleClass="menu-boton" text="Reportes" textFill="#f5f5f5">
