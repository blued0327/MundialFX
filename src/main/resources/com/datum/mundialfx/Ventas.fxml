<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1200.0" stylesheets="@../../../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.datum.mundialfx.VentasController">

   <top>
      <HBox prefHeight="100.0" prefWidth="1200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#volverMenu" prefHeight="33.0" prefWidth="103.0" text="Volver">
               <styleClass>
                  <String fx:value="menu-boton-volver" />
                  <String fx:value="boton-editar" />
               </styleClass></Button>
            <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../Images/upselling_18578836.png" />
               </image>
            </ImageView>
            <Label style="-fx-text-fill: #08164B; -fx-font-weight: bold; -fx-font-size: 20;" text="Gestión de Ventas" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtBuscarFactura" prefHeight="35.0" prefWidth="180.0" promptText="Buscar factura..." style="-fx-background-color: #F8FAFF; -fx-border-color: #CDD4E8; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;" />
            <Button fx:id="btnNuevaVenta" mnemonicParsing="false" onAction="#abrirFormulario" styleClass="boton-insertar" text="Nueva Venta" />
         </children>
      </HBox>
   </top>

   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #08164B;" text="Historial de Ventas" />
            <TableView fx:id="tablaVentas" prefHeight="250.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="colFactura" prefWidth="150.0" text="Factura" />
                  <TableColumn fx:id="colFecha" prefWidth="160.0" text="Fecha" />
                  <TableColumn fx:id="colCliente" prefWidth="180.0" text="Cliente" />
                  <TableColumn fx:id="colVendedor" prefWidth="120.0" text="Vendedor" />
                  <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total" />
                  <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                  <TableColumn fx:id="colAcciones" prefWidth="160.0" text="Acciones" />
               </columns>
               <placeholder>
                  <Label text="No hay ventas registradas." />
               </placeholder>
            </TableView>

            <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #08164B;" text="Detalle de Tickets de la Venta" />
            <TableView fx:id="tablaDetalle" prefHeight="200.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colPartido" prefWidth="220.0" text="Partido" />
                  <TableColumn fx:id="colEstadio" prefWidth="150.0" text="Estadio" />
                  <TableColumn fx:id="colAsiento" prefWidth="100.0" text="Asiento" />
                  <TableColumn fx:id="colSeccion" prefWidth="100.0" text="Sección" />
                  <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                  <TableColumn fx:id="colIva" prefWidth="100.0" text="IVA" />
               </columns>
               <placeholder>
                  <Label text="Seleccione una venta para ver sus tickets." />
               </placeholder>
            </TableView>
         </children>
      </VBox>
   </center>

   <right>
      <VBox fx:id="panelFormulario" managed="false" prefWidth="500.0" spacing="10.0" style="-fx-background-color: white; -fx-border-color: #CDD4E8; -fx-border-width: 0 0 0 1; -fx-padding: 20;" visible="false" BorderPane.alignment="TOP_CENTER">
         <children>
            <Label fx:id="lblTituloForm" style="-fx-text-fill: #08164B; -fx-font-weight: bold; -fx-font-size: 15;" text="Nueva Venta" />

            <Label style="-fx-text-fill: #5a647d; -fx-font-weight: bold;" text="Cliente" />
            <Label fx:id="lblCliente" style="-fx-text-fill: #08164B; -fx-font-size: 13; -fx-padding: 5; -fx-background-color: #F8FAFF; -fx-border-color: #CDD4E8; -fx-border-radius: 6; -fx-background-radius: 6;" text="Sin cliente seleccionado" wrapText="true" />

            <Label style="-fx-text-fill: #5a647d; -fx-font-weight: bold;" text="Partido" />
            <ComboBox fx:id="cmbPartido" maxWidth="1.7976931348623157E308" promptText="Seleccione un partido" />

            <Label style="-fx-text-fill: #5a647d; -fx-font-weight: bold;" text="Tickets disponibles" />
            <HBox spacing="8.0">
               <children>
                  <ComboBox fx:id="cmbFiltroSeccion" prefWidth="180.0" promptText="Filtrar por sección" />
                  <Label fx:id="lblConteoSecciones" style="-fx-text-fill: #5a647d; -fx-font-size: 11; -fx-padding: 4 0 0 8;" text="" wrapText="true" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <TableView fx:id="tablaDisponibles" prefHeight="150.0">
               <columns>
                  <TableColumn fx:id="colDispAsiento" prefWidth="100.0" text="Asiento" />
                  <TableColumn fx:id="colDispSeccion" prefWidth="120.0" text="Sección" />
                  <TableColumn fx:id="colDispPrecio" prefWidth="100.0" text="Precio" />
                  <TableColumn fx:id="colDispAccion" prefWidth="120.0" text="" />
               </columns>
               <placeholder>
                  <Label text="Seleccione un partido." />
               </placeholder>
            </TableView>

            <Label style="-fx-text-fill: #5a647d; -fx-font-weight: bold;" text="Tickets seleccionados" />
            <TableView fx:id="tablaCarrito" prefHeight="150.0">
               <columns>
                  <TableColumn fx:id="colCarrAsiento" prefWidth="100.0" text="Asiento" />
                  <TableColumn fx:id="colCarrSeccion" prefWidth="120.0" text="Sección" />
                  <TableColumn fx:id="colCarrPrecio" prefWidth="100.0" text="Precio" />
                  <TableColumn fx:id="colCarrAccion" prefWidth="120.0" text="" />
               </columns>
               <placeholder>
                  <Label text="Sin tickets aún." />
               </placeholder>
            </TableView>

            <Label fx:id="lblResumen" style="-fx-text-fill: #08164B; -fx-font-size: 13; -fx-padding: 8; -fx-background-color: #F8FAFF; -fx-border-color: #CDD4E8; -fx-border-radius: 6;" text="Subtotal: Q0.00" wrapText="true" />
            <Label fx:id="lblErrorForm" textFill="#d2303e" wrapText="true" />

            <HBox spacing="8.0">
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardarVenta" styleClass="boton-insertar" text="Confirmar Venta" HBox.hgrow="ALWAYS" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cerrarFormulario" styleClass="boton-editar" text="Cancelar" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </right>

</BorderPane>
