<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" stylesheets="@../../../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.datum.mundialfx.LogsController">

   <top>
      <HBox prefHeight="80.0" prefWidth="900.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </padding>

         <children>

            <Button mnemonicParsing="false" onAction="#volverMenu" prefHeight="33.0" prefWidth="103.0" styleClass="boton-editar" text=" Volver" />

            <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../Images/clock_18112909.png" />
               </image>
            </ImageView>

            <Label prefHeight="30.0" prefWidth="200.0" style="-fx-text-fill: #08164B; -fx-font-weight: bold; -fx-font-size: 20;" text="Logs del Sistema" />

            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />

         </children>
      </HBox>
   </top>

   <center>
      <VBox prefHeight="500.0" prefWidth="900.0" spacing="10.0" BorderPane.alignment="CENTER">

         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" />
         </padding>

         <children>

            <TableView fx:id="tablaLogs" prefHeight="450.0" prefWidth="860.0" VBox.vgrow="ALWAYS">

               <columns>

                  <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />

                  <TableColumn fx:id="colUsuarioId" prefWidth="90.0" text="Usuario ID" />

                  <TableColumn fx:id="colUsername" prefWidth="160.0" text="Username" />

                  <TableColumn fx:id="colFecha" prefWidth="180.0" text="Fecha" />

                  <TableColumn fx:id="colAccion" prefWidth="160.0" text="Acción" />

                  <TableColumn fx:id="colIp" prefWidth="180.0" text="IP" />

               </columns>

               <placeholder>
                  <Label text="No hay logs registrados." />
               </placeholder>

            </TableView>

            <HBox alignment="CENTER" spacing="10.0">

               <children>

                  <Button fx:id="btnAnterior" mnemonicParsing="false" onAction="#anteriorPagina" prefHeight="33.0" prefWidth="110.0" styleClass="boton-editar" text="← Anterior" />

                  <Label fx:id="lblPagina" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #08164B;" text="Pagina 1 de 1" />

                  <Button fx:id="btnSiguiente" mnemonicParsing="false" onAction="#siguientePagina" prefHeight="33.0" prefWidth="110.0" styleClass="boton-insertar" text="Siguiente →" />

               </children>

            </HBox>

         </children>

      </VBox>
   </center>

</BorderPane>
